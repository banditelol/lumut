{
  "name": "lumut",
  "private": true,
  "scripts": {
    "build": "npm run build:exp-data-editor && npm run build:data-editor-enhance",
    "build:exp-data-editor": "esbuild js/exp-data-editor/widget.jsx --bundle --format=esm --minify --outfile=lumut/static/exp-data-editor.js --loader:.jsx=jsx",
    "dev:exp-data-editor": "esbuild js/exp-data-editor/widget.jsx --bundle --format=esm --sourcemap --watch --outfile=lumut/static/exp-data-editor.js --loader:.jsx=jsx",
    "build:data-editor-enhance": "esbuild js/data-editor-enhance/widget.jsx --bundle --format=esm --minify --outfile=lumut/static/data-editor-enhance.js --loader:.jsx=jsx --loader:.css=text",
    "dev:data-editor-enhance": "esbuild js/data-editor-enhance/widget.jsx --bundle --format=esm --sourcemap --watch --outfile=lumut/static/data-editor-enhance.js --loader:.jsx=jsx --loader:.css=text"
  },
  "dependencies": {
    "@glideapps/glide-data-grid": "^6.0.3",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
